{
  "prompt": "Say hello.",
  "workspace": "workspaces/goal_check.json",
  "user_config": "[models.chat_completions]\nid = \"scripted\"\nprices = { input = 0, output = 100000000 }\n",
  "ask_args": [
    "--json",
    "--no-save",
    "--goal",
    "x",
    "--judge",
    "--max-cost",
    "0.05"
  ],
  "turns": [
    {
      "text": "Done."
    },
    {
      "text": "{\"status\":\"continue\",\"reason\":\"not yet .\",\"next\":\"go on\"}"
    },
    {
      "text": "Never sent."
    }
  ],
  "expect": {
    "exit_code": 3,
    "error_code": "limit_exceeded",
    "requests": 2,
    "stop_reason": "spend_limit"
  }
}
