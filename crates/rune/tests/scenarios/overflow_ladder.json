{
  "prompt": "Read a.txt, b.txt, c.txt, d.txt and e.txt, one at a time.",
  "workspace": "workspaces/six_files.json",
  "env": {
    "RUNE_CONTEXT_WINDOW": "200000"
  },
  "turns": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "name": "read_file",
          "arguments": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "name": "read_file",
          "arguments": {
            "path": "b.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c3",
          "name": "read_file",
          "arguments": {
            "path": "c.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c4",
          "name": "read_file",
          "arguments": {
            "path": "d.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c5",
          "name": "read_file",
          "arguments": {
            "path": "e.txt"
          }
        }
      ]
    },
    {
      "http_error": {
        "status": 400,
        "body": "{\"error\":{\"message\":\"This model's maximum context length is 8192 tokens\"}}"
      }
    },
    {
      "http_error": {
        "status": 400,
        "body": "{\"error\":{\"message\":\"This model's maximum context length is 8192 tokens\"}}"
      }
    },
    {
      "match": "Summarize the earlier portion of this conversation",
      "text": "The user asked for five files to be read; a.txt to e.txt were all read."
    },
    {
      "match": "Summarize the earlier portion of this conversation",
      "text": "The user asked for five files to be read; a.txt to e.txt were all read."
    },
    {
      "text": "Finished after compacting twice."
    }
  ],
  "expect": {
    "exit_code": 0,
    "final_output": "Finished after compacting twice.",
    "any_request_contains": [
      "<context_handoff>"
    ],
    "requests": 10,
    "stop_reason": "end_turn"
  }
}
