{
  "prompt": "Read notes.txt.",
  "workspace": "workspaces/repeat_read.json",
  "turns": [
    {
      "tool_calls": [
        {
          "id": "call_1",
          "name": "read_file",
          "arguments": {
            "path": "notes.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_2",
          "name": "read_file",
          "arguments": {
            "path": "notes.txt"
          }
        }
      ]
    },
    {
