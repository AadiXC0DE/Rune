{
  "prompt": "Read notes.txt.",
  "workspace": "workspaces/repeat_read.json",
  "turns": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "name": "read_file",
          "arguments": "{\"path\":\"no"
        }
      ],
      "finish": "length"
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "name": "read_file",
          "arguments": {
            "path": "notes.txt"
          }
        }
      ]
    },
    {
      "text": "Read it."
    }
  ],
  "expect": {
    "exit_code": 0,
    "final_output": "Read it.",
    "requests": 3,
    "request_contains": [
      {
        "request": 2,
        "text": "Your tool call was cut at the output limit"
      }
    ]
  }
}
