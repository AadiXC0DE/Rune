{
  "prompt": "Read a.txt, b.txt, c.txt, d.txt, e.txt and f.txt, one at a time.",
  "workspace": "workspaces/cache_one_checkpoint.json",
  "env": {
    "RUNE_CONTEXT_WINDOW": "128000",
    "RUNE_LIMITS": "compaction_trigger_percent=10,compaction_keep_tokens=3000"
  },
  "turns": [
    {
      "tool_calls": [
        {
          "id": "call_1",
          "name": "read_file",
          "arguments": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_2",
          "name": "read_file",
          "arguments": {
            "path": "b.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_3",
          "name": "read_file",
          "arguments": {
            "path": "c.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_4",
          "name": "read_file",
          "arguments": {
            "path": "d.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_5",
          "name": "read_file",
          "arguments": {
            "path": "e.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_6",
          "name": "read_file",
          "arguments": {
            "path": "f.txt"
          }
        }
      ]
    },
    {
      "match": "Write a checkpoint of the conversation above",
      "text": "## Goal\n- read the files the user named\n## Constraints\n- none\n## Decisions\n- none\n## State\n### Done\n- a.txt to d.txt were read\n### In progress\n- none\n### Blocked\n- none\n## Next steps\n- read e.txt and f.txt\n## Files that matter\n- the .txt files in the workspace\n## Facts to keep\n- none"
    },
    {
      "text": "All six files were read."
    }
  ],
  "expect": {
    "exit_code": 0,
    "prefix_breaks": 1,
    "any_request_contains": [
      "<conversation-checkpoint>"
    ]
  }
}
