{
  "prompt": "Read a.txt, b.txt, c.txt, d.txt, e.txt and f.txt, one at a time.",
  "workspace": "workspaces/six_files.json",
  "env": {
    "RUNE_LIMITS": "compaction_keep_tokens=0"
  },
  "user_config": "[models.chat_completions]\nid = \"scripted\"\ncontext_window = 8000\n",
  "turns": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "name": "read_file",
          "arguments": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "name": "read_file",
          "arguments": {
            "path": "b.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c3",
          "name": "read_file",
          "arguments": {
            "path": "c.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c4",
          "name": "read_file",
          "arguments": {
            "path": "d.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c5",
          "name": "read_file",
          "arguments": {
            "path": "e.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c6",
          "name": "read_file",
          "arguments": {
            "path": "f.txt"
          }
        }
      ]
    },
    {
      "match": "Write a checkpoint of the conversation above",
      "text": "## Goal\n- read the files the user named\n## Constraints\n- none\n## Decisions\n- none\n## State\n### Done\n- a.txt to d.txt were read\n### In progress\n- none\n### Blocked\n- none\n## Next steps\n- read e.txt and f.txt\n## Files that matter\n- the .txt files in the workspace\n## Facts to keep\n- none"
    },
    {
      "text": "All six files were read."
    }
  ],
  "expect": {
    "exit_code": 0,
    "final_output": "All six files were read.",
    "any_request_contains": [
      "<conversation-checkpoint>"
    ],
    "requests": 8,
    "stop_reason": "end_turn"
  }
}
