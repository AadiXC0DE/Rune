{
  "prompt": "Read a.txt, b.txt and c.txt, then answer.",
  "workspace": "workspaces/six_files.json",
  "user_config": "[models.chat_completions]\nid = \"scripted\"\nprices = { input = 100000000, output = 100000000 }\n",
  "ask_args": [
    "--json",
    "--no-save",
    "--max-cost",
    "0.10"
  ],
  "turns": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "name": "read_file",
          "arguments": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "name": "read_file",
          "arguments": {
            "path": "b.txt"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c3",
          "name": "read_file",
          "arguments": {
            "path": "c.txt"
          }
        }
      ]
    },
    {
      "text": "All read."
    }
  ],
  "expect": {
    "exit_code": 1,
    "error_code": "limit_exceeded",
    "max_requests": 1
  }
}
