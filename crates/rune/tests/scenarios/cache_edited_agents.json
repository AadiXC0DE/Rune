{
  "prompt": "Switch the rule to spaces, then read a.txt.",
  "workspace": "workspaces/cache_edited_agents.json",
  "turns": [
    {
      "tool_calls": [
        {
          "id": "call_1",
          "name": "edit_file",
          "arguments": {
            "path": "AGENTS.md",
            "old_string": "Use tabs.",
            "new_string": "Use spaces."
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "call_2",
          "name": "read_file",
          "arguments": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "text": "The rule now says spaces."
    },
    {
      "text": "No check applies."
    }
  ],
  "expect": {
    "exit_code": 0,
    "prefix_breaks": 0,
    "request_contains": [
      {
        "request": 2,
        "text": "AGENTS.md changed on disk"
      }
    ]
  }
}
